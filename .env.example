# ============================================================
# Project-local env for the n8n-agent workspace
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit real tokens/secrets.
# ============================================================

# --- n8n MCP access token (REQUIRED for opencode to talk to n8n) ---
# Create this in the n8n UI: Settings > Instance-level MCP > Connect a client > API key.
# Put the generated token in the project-local, git-ignored file .n8n-mcp-token
# (opencode reads it via {file:.n8n-mcp-token} in opencode.json). Keeping the
# value here in .env is not required; .n8n-mcp-token is the source opencode uses.
N8N_MCP_TOKEN=

# --- n8n Docker (docker-compose.yml) variables ---
# Encryption key: change to a long random string for a production-like instance.
N8N_ENCRYPTION_KEY=please-change-me-to-a-long-random-string
# Public host/port/protocol the instance is served under.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
